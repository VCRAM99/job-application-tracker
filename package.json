{
  "name": "job-application-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_TURNSTILE=1 tsx e2e/support/serve.ts build && E2E_TURNSTILE=1 playwright test",
    "test:e2e:nobuild": "E2E_TURNSTILE=1 playwright test",
    "perf:seed": "tsx --conditions=react-server scripts/perf/seed-dataset.ts",
    "perf:measure": "tsx --conditions=react-server scripts/perf/measure.ts",
    "ui:screenshots": "tsx --conditions=react-server scripts/ui/screenshots.ts",
    "test:eval": "tsx --conditions=react-server scripts/eval/run.ts --mock --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/nextjs": "^11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "docx": "9.12.0",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
