# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# local Supabase CLI state
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Claude Code session config (dev-server launch). Nothing here is meant to be committed.
.claude/

# e2e (Playwright) local state and output
/e2e/.state/
/test-results/
/playwright-report/
/perf-results/
