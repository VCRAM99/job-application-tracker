NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Do not prefix these with NEXT_PUBLIC_ and do not commit real values.
# AI_FEATURES_ENABLED=false
# AI_CREDENTIALS_KEY=
# AI_CREDENTIALS_KEY_VERSION=1
# AI_ACCOUNTING_SECRET=
# AI_MANAGED_ENABLED=false
# AI_MANAGED_MONTHLY_REQUEST_LIMIT=0
# AI_MANAGED_MONTHLY_TOKEN_LIMIT=0
# AI_PLATFORM_OPENAI_API_KEY=
# AI_PLATFORM_ANTHROPIC_API_KEY=
# AI_PLATFORM_GOOGLE_API_KEY=

# Recommended jobs. Server-only. Leave unset in production until each control is approved.
# The UI flag does not enable fetching, scheduling, or email.
# JOB_RECOMMENDATIONS_ENABLED=false
# JOB_INGESTION_ENABLED=false
# JOB_REFRESH_ENABLED=false
# JOB_EMAIL_DELIVERY_ENABLED=false
# JOB_EMAIL_FROM=
# JOB_CATALOG_WRITE_SECRET=
# JOB_SCHEDULER_SECRET=

# Fit analysis. Server-only. Off unless JOB_ANALYSIS_ENABLED is exactly true and career AI is enabled.
# JOB_ANALYSIS_ENABLED=false
# JOB_ANALYSIS_OPENAI_MODEL=gpt-5.4-mini
# JOB_ANALYSIS_ANTHROPIC_MODEL=claude-haiku-5-5
# JOB_ANALYSIS_GOOGLE_MODEL=gemini-3.8-flash  # or gemini-3.5-flash-lite when 3.8 Flash is overloaded
# JOB_ANALYSIS_MOCK_PROVIDER=false
